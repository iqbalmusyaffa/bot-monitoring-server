# Telegram Bot Configuration
# Token didapat dari @BotFather
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Whitelist Telegram User ID (dipisahkan koma)
# User ID bisa didapatkan dari bot @userinfobot
ALLOWED_TELEGRAM_USER_IDS=123456789,987654321

# Monitoring Settings
CHECK_INTERVAL=1m
REQUEST_TIMEOUT=10s
MAX_HOSTS=50
MAX_CONCURRENT_CHECKS=5
MAX_RESPONSE_BODY=1048576
MAX_REDIRECTS=5
MONITOR_PORTS=22,80,443

# Telegram Rate Limit
COMMAND_RATE_LIMIT=10
COMMAND_RATE_WINDOW=1m

# Database & History Retention
DB_PATH=data/monitor.db
RETENTION_DAYS=7

# Logging (DEBUG, INFO, WARN, ERROR)
LOG_LEVEL=INFO
